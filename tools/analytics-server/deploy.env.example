# deploy.env に写して、自分の環境の値を書く。deploy.env は git に入れない (.gitignore 済み)。
SSH_HOST=your-server-alias      # ssh でつなぐ名前 (~/.ssh/config の Host)
OPS_USER=ops-user               # 取得・集計・通知を動かすユーザー (鍵を持つ。sudo が使える)
OPS_HOME=/home/ops-user
BOT_USER=bot-user               # Claude を無人で動かすユーザー (sudo なし。鍵は読めない)
BOT_HOME=/home/bot-user
