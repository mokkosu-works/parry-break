[Unit]
Description=Claude weekly YouTube analysis
After=yt-weekly-fetch.service
OnSuccess=yt-weekly-handoff.service
OnFailure=notify-failure@%N.service

[Service]
Type=oneshot
User=@BOT_USER@
ExecStart=/usr/local/bin/claude-weekly-analysis.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/analytics/reports @BOT_HOME@/reports @BOT_HOME@/.claude @BOT_HOME@/.local @BOT_HOME@/work
