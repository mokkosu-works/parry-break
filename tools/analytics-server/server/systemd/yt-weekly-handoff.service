[Unit]
Description=Validate Claude's proposals and write the handoff file
OnSuccess=yt-weekly-notify.service
OnFailure=notify-failure@%N.service

[Service]
Type=oneshot
User=@OPS_USER@
ExecStart=/usr/bin/python3 @OPS_HOME@/analytics/handoff.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/analytics
