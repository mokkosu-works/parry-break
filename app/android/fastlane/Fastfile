# Android のテスト配信と本番への公開。CI (.github/workflows/release.yml / promote.yml) から呼ぶ。
# 内部テストへの最初のリリースは Play Console から手で作る (API ではアプリの最初のリリースを作れない)。
# 手順は docs/release-flow.md。リリースノートは metadata/android/<言語>/changelogs/default.txt。
default_platform(:android)

SKIP_LISTING = {
  json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
  skip_upload_metadata: true,
  skip_upload_images: true,
  skip_upload_screenshots: true,
}.freeze

platform :android do
  # flutter build appbundle の後に呼ぶ。内部テストに上げる
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      **SKIP_LISTING,
    )
  end

  # 内部テストのビルドを本番に昇格し、全員に公開する (段階的公開はしない)
  #   fastlane promote version_code:123
  lane :promote do |options|
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: options.fetch(:version_code).to_i,
      # 昇格した先 (本番) のリリースの状態
      track_promote_release_status: "completed",
      skip_upload_aab: true,
      skip_upload_apk: true,
      **SKIP_LISTING,
    )
  end
end
